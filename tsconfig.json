{
  "compilerOptions": {
    // CommonJS for Node 22 (its resolution follows: node10); a default
    // import of a CommonJS package works through esModuleInterop. Each file
    // compiles alone (isolatedModules), as Vitest's transform needs.
    "module": "commonjs",
    "target": "ES2023",
    "esModuleInterop": true,
    "isolatedModules": true,
    "strict": true,
    "skipLibCheck": true,
    // dist/ keeps source maps for stack traces and no comments; the build
    // config (tsconfig.build.json) turns incremental off.
    "outDir": "dist",
    "sourceMap": true,
    "removeComments": true,
    "incremental": true,
    "baseUrl": ".",
    // Views under src/web/ are typed JSX rendered to strings by hono/jsx
    // (escape by default). The build (tsc) and Vitest (Vite's Oxc, which reads
    // them from this file) share the two settings.
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    // src/web/i18n.ts types t() keys from src/i18n/en/lang.json.
    "resolveJsonModule": true,
    // A spec importing a plain-JS module (public/js/, scripts/lint/*.mjs)
    // gets its JSDoc types, not an implicit any; JS files are only ever
    // reached through an import, never included (the include list below).
    "allowJs": true,
    "types": ["node"]
  },
  // The service worker runs in a worker scope, not Node: it is checked by
  // views/assets/tsconfig.json (npm run typecheck runs both).
  // .claude/worktrees holds whole checkouts made by agent tooling.
  // devkit/ is materialized tooling (.devkit-rev); its templates target other module settings.
  "include": ["**/*.ts", "**/*.tsx", "vitest.config.mts"],
  "exclude": ["node_modules", "dist", "views/assets", ".claude", "devkit"]
}
