# devkit, materialized from .devkit-rev by .devkit-bootstrap.sh (never tracked), and the
# bootstrap's lock and swap temporaries a killed run leaves beside it
/devkit/
/devkit.*

# Dependencies and what the build writes: tsc's dist/, the CI metrics' build/
/node_modules/
/dist/
/build/

# Secrets and local settings: every .env.<name> (the committed .env holds only defaults)
**/.env.*

# What the running app writes locally: photos (DATA_PATH) and the cutout model
# (MODELS_PATH, 940 MB), and a LOG_FILE or npm's debug log
/data/
/models/
/logs/
*.log
# Node's diagnostic reports (--report-on-fatalerror)
/report.*.json

# Generated into public/ by npm run build; the server reads them, git never does
/public/bundle.css
/public/sw.js
/public/build.json
/public/vendor/
/public/modules/
# Bundled from views/assets/outbox.ts and views/assets/page/*.ts (npm run generate:pages): wholly
# the build's, which empties it of anything it did not output
/public/js/gen/
# Generated from the lockfile and node_modules (npm run generate:notices)
/public/THIRD-PARTY-NOTICES.txt
# Precompressed variants (npm run generate:precompress)
/public/**/*.br
/public/**/*.gz
# esbuild's bundle of the service worker, before Workbox injects the precache list
/views/assets/src-sw.js

# Test and audit output: coverage, Playwright's results and reports, the seed
# personas' screenshots (test/screenshots.spec.ts), Lighthouse's working
# directory, and the page audit's and Lighthouse's results
/coverage/
/test-results
/*-report/
/playwright/
/screenshots/
/.lighthouseci/
/scripts/results

# Editors: only the shared VS Code settings are tracked
/.idea/
/.vscode/*
!/.vscode/settings.json
**/.DS_Store

# Agent tooling (worktrees are full checkouts)
**/.claude/*
!/.claude/settings.json

# Python bytecode
__pycache__/
*.pyc
