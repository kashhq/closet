# devkit, materialized from .devkit-rev by .devkit-bootstrap.sh (never tracked), and the
# bootstrap's lock and swap temporaries a killed run leaves beside it
/devkit/
/devkit.*

# compiled output
/dist
/node_modules
/build

# Logs
logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# OS
.DS_Store

# Tests
/coverage
/.nyc_output

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/mcp.json

# dotenv environment variable files
.env.*

# temp directory
.temp
.tmp

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json


.lighthouseci/
**/*.db
**/*.sqlite
**/*.sqlite3
data/**
# The server-mode cutout model (MODELS_PATH default, 940 MB)
/models/
public/bundle.css
public/sw.js
# Bundled from views/assets/outbox.ts and views/assets/page/*.ts (npm run generate:pages): wholly
# the build's, which empties it of anything it did not output
public/js/gen/
public/build.json
public/vendor/
public/modules/
# Generated from the lockfile and node_modules (npm run generate:notices)
public/THIRD-PARTY-NOTICES.txt
# Precompressed variants (npm run generate:precompress)
public/**/*.br
public/**/*.gz
views/assets/src-sw.js

# Playwright
node_modules/
/test-results/
# The seed personas' phone screenshots (test/screenshots.spec.ts)
/screenshots/
/playwright-report/
/blob-report/
/playwright/.cache/
/playwright/.auth/

# Load test results
/scripts/results/

# Agent tooling (worktrees are full checkouts)
**/.claude/*
!/.claude/settings.json

# Python bytecode
__pycache__/
*.pyc
